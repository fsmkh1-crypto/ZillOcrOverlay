<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="true"
        android:label="질올 OCR 오버레이"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZillOcrOverlay">
        <activity
            android:name=".LearningManagerActivity"
            android:exported="false"
            android:label="화자 · 학습 관리" />
        <activity
            android:name=".GlossaryManagerActivity"
            android:exported="false"
            android:label="질올 용어집 관리" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="질올 OCR 오버레이">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".capture.ScreenOcrService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="false" />
    </application>
</manifest>
